---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import CreditCardIcon from '../components/icons/CreditCardIcon.astro';
import DocumentIcon from '../components/icons/DocumentIcon.astro';
import { keystaticReader } from '../lib/keystatic';

const nastaveni = await keystaticReader.singletons.nastaveniWebu.read();
const platby = nastaveni?.platby;
const cerpani = (await getCollection('cerpani'))
  .filter(({ data }) => data.publikace.publikovano)
  .sort((a, b) => b.data.uploadedAt.getTime() - a.data.uploadedAt.getTime());
const formatDatumNahrani = new Intl.DateTimeFormat('cs-CZ', { dateStyle: 'long' });
---

<Layout title="Platby a hospodaření | Klub rodičů při ZŠ Kavčí hory">
  <Header />
  <main>
    <PageHeader eyebrow="Placení a čerpání" title="Platby a hospodaření" lead="Všechny informace o členských příspěvcích, způsobu platby a využití prostředků Klubu rodičů."><CreditCardIcon slot="icon" /></PageHeader>
    <section class="payments">
      {platby ? <>
        <div class="membership-fees">
          <section class="payment-card"><h2>Členský příspěvek za žáka ZŠ</h2><p class="price">{platby.membershipFeePrimary.toLocaleString('cs-CZ')} {platby.currency === 'CZK' ? 'Kč' : platby.currency}</p><p class="price-note">za školní rok</p></section>
          <section class="payment-card"><h2>Členský příspěvek za žáka SŠ</h2><p class="price">{platby.membershipFeeSecondary.toLocaleString('cs-CZ')} {platby.currency === 'CZK' ? 'Kč' : platby.currency}</p><p class="price-note">za školní rok</p></section>
        </div>
        <section class="payment-info card"><h2>Jak zaplatit</h2><p>QR kód pro platbu za své dítě najdete nově v&nbsp;Bakalářích v&nbsp;sekci Platby.</p></section>
      </> : <section class="notice"><h2>Informace k platbě připravujeme</h2><p>Platební údaje budou zveřejněny brzy.</p></section>}
      {cerpani.length > 0 && <section class="document-group"><h2>Hospodaření</h2><p>Dokumenty o&nbsp;hospodaření Klubu rodičů a&nbsp;využití členských příspěvků.</p><ul>{cerpani.map(({ data }) => <li><a href={data.file} target="_blank" rel="noopener noreferrer"><DocumentIcon /><span class="document-copy"><span>{data.title}</span><time datetime={data.uploadedAt.toISOString()}>{formatDatumNahrani.format(data.uploadedAt)}</time></span></a></li>)}</ul></section>}
    </section>
  </main>
  <Footer />
</Layout>

<style>
.payments { max-width: 900px; margin: 0 auto; padding-bottom: 5rem; }
.payment-card, .card, .notice { padding: 2rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.membership-fees { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-bottom: 4rem; }
.payment-card { padding: 2.5rem; text-align: center; }
.price { margin: .75rem 0 .25rem; font-family: "Libre Baskerville", serif; font-size: clamp(3.5rem, 8vw, 4.5rem); color: var(--color-primary); }
.price-note { color: var(--color-text-light); }
.payment-info { margin-bottom: 5rem; text-align: center; }
.payment-info h2 { margin-bottom: .75rem; }
.document-group { padding-top: 3rem; border-top: 1px solid var(--color-border); }
.document-group h2 { margin-bottom: .75rem; }
.document-group p { margin-bottom: 1.5rem; }
.document-group ul { list-style: none; margin: 0; padding: 0; }
.document-group li + li { margin-top: 1rem; }
.document-group a { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-card); color: var(--color-secondary); text-decoration: none; }
.document-copy { display: grid; gap: .2rem; }
.document-copy time { color: var(--color-text-light); font-size: .875rem; }
@media (max-width: 800px) { .membership-fees { grid-template-columns: 1fr; } }
</style>
