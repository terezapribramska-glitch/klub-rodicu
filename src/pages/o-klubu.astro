---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UsersIcon from '../components/icons/UsersIcon.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout>
  <Header />

  <main>

    <PageHeader
  eyebrow="O nás"
  title="O Klubu rodičů"
  lead="Společně podporujeme školu, její žáky i školní komunitu. Klub rodičů propojuje rodiče se školou a pomáhá financovat aktivity, které dětem zpříjemňují školní život."
>
  <UsersIcon slot="icon" />
</PageHeader>

    <section class="about-intro">

      <div class="content">

        <div class="text">
          <h2>Co děláme</h2>

          <p>
            Klub rodičů podporuje činnost školy po stránce organizační
            i finanční. Přispíváme na projekty, školní akce, vybavení
            i aktivity, které nejsou hrazeny z běžného rozpočtu školy.
          </p>

          <p>
            Naším cílem je vytvářet prostředí, ve kterém se děti cítí dobře,
            mohou rozvíjet své zájmy a zažívají ve škole příjemnou atmosféru.
          </p>

        </div>

        <div class="photo">

          <img
            src="/images/skola-k-sidlisti.png"
            alt="Budova školy"
          />

        </div>

      </div>

    </section>

    <section class="support">

  <h2>Co podporujeme</h2>

  <div class="support-grid">

    <article class="support-card">
      <h3>🎓 Vzdělávání</h3>

      <p>
        Podporujeme vzdělávací projekty, besedy, workshopy
        a další aktivity rozvíjející znalosti a dovednosti žáků.
      </p>
    </article>

    <article class="support-card">
      <h3>🏃 Sport</h3>

      <p>
        Přispíváme na sportovní akce, soutěže i vybavení,
        které dětem umožňuje aktivně trávit čas.
      </p>
    </article>

    <article class="support-card">
      <h3>🎭 Kultura</h3>

      <p>
        Podporujeme divadelní představení, kulturní programy,
        školní slavnosti i společné zážitky.
      </p>
    </article>

    <article class="support-card">
      <h3>🌱 Školní prostředí</h3>

      <p>
        Pomáháme zlepšovat prostředí školy a podporujeme aktivity,
        které posilují školní komunitu.
      </p>
    </article>

  </div>

</section>

<section class="join">

  <div class="join-box">

    <h2>Chcete se zapojit?</h2>

    <p>
      Klub rodičů stojí na ochotě rodičů věnovat svůj čas, nápady a energii.
      Ať už můžete pomoci s organizací školních akcí, přinést nový nápad nebo
      se zapojit do činnosti výboru, budeme rádi za každou pomoc.
    </p>

    <a href="/kontakty" class="button">
      Kontaktujte nás
    </a>

  </div>

</section>

  </main>

  <Footer />
</Layout>

<style>

.about-intro {
  padding: 4rem 0 5rem;
}

.content {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 4rem;
  align-items: center;
}

.photo img {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.support {
  padding: 5rem 0;
}

.support h2 {
  margin-bottom: 2.5rem;
}

.support-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.support-card {
  padding: 2rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.support-card h3 {
  margin-bottom: 1rem;
}

.support-card p {
  margin: 0;
  color: var(--color-text-light);
}

.join {
  padding: 5rem 0;
}

.join-box {
  background: linear-gradient(
    135deg,
    var(--color-blue-light),
    #d8edf2
  );

  border-radius: var(--radius-lg);
  padding: 4rem;
  text-align: center;
}

.join-box h2 {
  margin-bottom: 1.25rem;
}

.join-box p {
  max-width: 700px;
  margin: 0 auto 2rem;
  color: var(--color-text);
}

.button {
  display: inline-block;
  padding: .9rem 1.8rem;
  background: var(--color-primary);
  color: white;
  border-radius: 999px;
  text-decoration: none;
  transition: var(--transition);
}

.button:hover {
  background: var(--color-secondary);
  color: white;
  transform: translateY(-2px);
  text-decoration: none;
}

@media (max-width: 900px) {

  .content {
    grid-template-columns: 1fr;
  }
  .support-grid {
    grid-template-columns: 1fr;
  }
    .join-box {
    padding: 2.5rem;
  }

}
</style>