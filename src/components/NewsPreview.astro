---
import { getCollection } from 'astro:content';

const formatDate = new Intl.DateTimeFormat('cs-CZ', { dateStyle: 'long' });
const novinky = (await getCollection('novinky'))
  .filter(({ data }) => data.publikace.publikovano)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<section class="news-preview">
  <div class="section-header"><h2>Poslední novinky</h2></div>
  {novinky.length ? <div class="news-grid">{novinky.map((novinka) => (
    <article class="news-card">
      <time datetime={novinka.data.publishedAt.toISOString()}>{formatDate.format(novinka.data.publishedAt)}</time>
      <h3><a href={`/novinky/${novinka.id}`}>{novinka.data.title}</a></h3>
      <p>{novinka.data.summary}</p>
    </article>
  ))}</div> : <p>Novinky připravujeme.</p>}
  <a class="all-news-link" href="/novinky">Všechny novinky →</a>
</section>

<style>
.news-preview { padding: 5rem 0; }
.section-header { margin-bottom: 2rem; }
.news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.news-card { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
.news-card time { display: block; margin-bottom: 0.75rem; font-size: 0.85rem; color: var(--color-text-light); }
.news-card h3 { margin-bottom: 0.75rem; }
.news-card h3 a { color: inherit; text-decoration: none; }
.news-card h3 a:hover { color: var(--color-secondary); }
.news-card p { margin: 0; }
.all-news-link { display: inline-block; margin-top: 2rem; font-size: 0.95rem; }
@media (max-width: 800px) {
  .news-preview { padding: 3rem 0; }
  .news-grid { grid-template-columns: 1fr; }
}
</style>
